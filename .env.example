# Local Development (MySQL)
# Copy this file to .env and replace the values.
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/your_db

# Production (Neon PostgreSQL)
# DATABASE_URL=postgresql://user:password@ep-host.neon.tech/neondb?sslmode=require

# Set one DATABASE_URL above and keep this false for local MySQL. Neon uses
# sslmode=require in its connection URL and does not need this setting.
DATABASE_SSL=false
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ADMIN_REGISTER_KEY=replace-with-a-separate-admin-registration-secret
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
